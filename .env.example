# Supabase is optional. Leave both values empty to use data/pastifico-db.json locally.
# To connect a Supabase project, fill both values. Keep the service role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: when set, staff routes (orders list/status, menu changes) require the x-kitchen-pin header.
KITCHEN_PIN=
