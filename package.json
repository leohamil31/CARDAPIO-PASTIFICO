{
  "name": "pastifico-api",
  "version": "1.0.0",
  "description": "Pastifico - sistema de autoatendimento para restaurante de massas italianas em Node.js + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:supabase": "tsx scripts/migrate-json-to-supabase.ts"
  },
  "keywords": [
    "node",
    "express",
    "typescript",
    "restaurant",
    "api",
    "italian-food",
    "pastifico"
  ],
  "author": {
    "name": "Leonardo Hamilton Moreira de Camargo",
    "url": "https://github.com/leohamil31"
  },
  "contributors": [
    "Leonardo Hamilton Moreira de Camargo",
    "Gabriel Henrique Brito Nery",
    "Ana Gabriela Rodrigues Harps"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leohamil31/CARDAPIO-PASTIFICO.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "dotenv": "^18.0.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "homepage": "https://leohamil31.github.io/CARDAPIO-PASTIFICO/"
}
